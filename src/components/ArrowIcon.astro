---
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M4.5 11.5 11.5 4.5" />
  <path d="M5.5 4.5h6v6" />
</svg>
