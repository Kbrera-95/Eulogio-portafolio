---
import { faq } from '../data/site';
---

<section class="section" id="faq">
  <div class="container">
    <div class="faq">
      <div class="faq__head reveal">
        <h2>{faq.title}</h2>
        <p>{faq.text}</p>
      </div>

      <div class="faq__list reveal" style="--delay:120ms">
        {
          faq.items.map((item) => (
            <details class="qa" name="faq">
              <summary>
                <span>{item.q}</span>
                <span class="qa__sign" aria-hidden="true" />
              </summary>
              <div class="qa__body">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 64px;
    align-items: start;
  }

  .faq__head p {
    margin-top: 16px;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: -0.36px;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .qa {
    background: var(--surface);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.34px;
    color: var(--ink-2);
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa__sign {
    position: relative;
    flex: 0 0 20px;
    height: 20px;
  }

  .qa__sign::before,
  .qa__sign::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.6px;
    background: var(--ink-2);
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  .qa__sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__sign::after {
    transform: rotate(0deg);
  }

  .qa__body {
    padding: 0 24px 22px;
  }

  .qa__body p {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.32px;
    max-width: 62ch;
  }

  @media (max-width: 980px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
