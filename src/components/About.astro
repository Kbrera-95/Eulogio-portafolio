---
import { about } from '../data/site';
---

<section class="about-section" id="sobremi">
  <div class="container">
    <div class="about">
      <div class="about__intro reveal">
        <img
          class="about__photo"
          src={about.photo}
          alt="Eulogio Cabrera en su espacio de trabajo"
          width="120"
          height="120"
          loading="lazy"
          decoding="async"
        />

        <div class="about__heading">
          <span class="eyebrow">{about.eyebrow}</span>
          <h2>{about.title}</h2>

          <ul class="tags">
            {about.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </div>

      <div class="about__body reveal" style="--delay:120ms">
        {about.paragraphs.map((text) => <p>{text}</p>)}

        <div class="stats">
          {
            about.stats.map((stat) => (
              <div class="stat">
                <span class="stat__value">
                  <span data-count={stat.value}>0</span>
                  {stat.suffix}
                </span>
                <span class="stat__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Bloque a todo el ancho sobre fondo oscuro */
  .about-section {
    padding-block: 96px;
    background: #24242a;
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  /* Foto a la izquierda, bloque de título a la derecha */
  .about__intro {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 28px;
    align-items: start;
  }

  .about__photo {
    width: 120px;
    height: 120px;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14), 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  /* Inversión de color: el eyebrow y los títulos van sobre fondo oscuro */
  .about__heading .eyebrow {
    color: #8fb0ff;
    background: rgba(143, 176, 255, 0.14);
  }

  .about__heading h2 {
    color: #fff;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.14px;
    color: rgba(255, 255, 255, 0.88);
  }

  .about__body p {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.32px;
    color: rgba(255, 255, 255, 0.68);
  }

  .about__body p + p {
    margin-top: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 52px;
    font-weight: 600;
    letter-spacing: -0.88px;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    color: rgba(255, 255, 255, 0.56);
  }

  @media (max-width: 980px) {
    .about {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 768px) {
    .about-section {
      padding-block: 64px;
    }

    .about__intro {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
