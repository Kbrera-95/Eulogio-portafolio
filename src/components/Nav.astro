---
import { nav, site } from '../data/site';

// Marca el ítem activo cuando el link apunta a una página (no a un ancla de la home)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && href.replace(/\/$/, '') === path;
---

<header class="nav" id="top">
  <div class="container">
    <div class="nav__bar">
      <a class="nav__logo" href="/" aria-label={`${site.name}, inicio`}>
        {site.name}<span>.</span>
      </a>

      <nav class="nav__links" aria-label="Principal">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="nav__actions">
        <a
          class="nav__icon"
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn (se abre en una pestaña nueva)"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.64h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.66c0-1.35-.03-3.08-1.9-3.08-1.9 0-2.19 1.46-2.19 2.98V21h-4V9z"
            ></path>
          </svg>
        </a>

        <a class="btn btn--primary btn--sm" href={site.ctaHref}>{site.ctaLabel}</a>

        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-mobile">
          <span class="sr-only">Abrir menú</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <nav class="nav__mobile" id="nav-mobile" hidden aria-label="Principal móvil">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 64px;
    padding: 0 12px 0 24px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius);
    box-shadow: var(--shadow-nav);
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    line-height: 26.4px;
    color: var(--ink);
  }

  .nav__logo span {
    color: var(--brand);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav__links a {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.14px;
    color: var(--ink-2);
    transition: color 0.2s ease;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--brand);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #f0f0f2;
    color: var(--ink-2);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav__icon:hover {
    background: var(--brand);
    color: #fff;
  }

  .nav__toggle {
    display: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #f0f0f2;
    place-items: center;
    gap: 5px;
  }

  .nav__toggle span[aria-hidden] {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--ink-2);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-radius: var(--radius);
    box-shadow: var(--shadow-nav);
  }

  .nav__mobile a {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    padding: 10px 12px;
    border-radius: 10px;
  }

  .nav__mobile a:hover {
    background: #f4f4f6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .nav__links {
      display: none;
    }

    .nav__toggle {
      display: grid;
    }

    .nav__mobile:not([hidden]) {
      display: flex;
    }
  }

  @media (max-width: 520px) {
    .nav__bar {
      padding-inline: 16px 8px;
    }

    .nav__actions .btn {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.querySelector<HTMLElement>('#nav-mobile');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });

  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (menu) menu.hidden = true;
    })
  );
</script>
