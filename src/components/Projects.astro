---
import { projects, site } from '../data/site';
import ArrowIcon from './ArrowIcon.astro';

const total = projects.items.length;
---

<section class="section" id="proyectos">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{projects.eyebrow}</span>
      <h2>{projects.title}</h2>
    </div>

    <!--
      Stack de cards: cada una es sticky con un top escalonado, así la siguiente
      se superpone sobre la anterior al bajar y la animación se revierte al subir.
    -->
    <div class="stack" data-project-stack>
      {
        projects.items.map((item, i) => (
          <article class="pcard" style={`--i:${i}; --total:${total}`}>
            <a class="pcard__inner" href={item.href} data-project-card>
              <img
                class="pcard__img"
                src={item.cover}
                srcset={`${item.coverSmall} 800w, ${item.cover} 1600w`}
                sizes="(max-width: 1200px) 100vw, 1152px"
                alt={`Vista del proyecto ${item.name}`}
                width="1600"
                height="900"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="pcard__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
              </span>

              <div class="pcard__info">
                <span class="pcard__meta">
                  <span class="pcard__cat">{item.category}</span>
                  <span class="pcard__dot" aria-hidden="true" />
                  <span>{item.year}</span>
                </span>
                <h3 class="pcard__title">{item.name}</h3>
                <p class="pcard__text">{item.text}</p>
                <ul class="pcard__tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <span class="pcard__cta">
                  Ver proyecto
                  <span class="pcard__arrow">
                    <ArrowIcon size={16} />
                  </span>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <div class="banner reveal">
      <div class="banner__mark" aria-hidden="true">Bē</div>
      <div class="banner__text">
        <h4>{projects.banner.title}</h4>
        <p>{projects.banner.text}</p>
      </div>
      <a class="btn btn--primary btn--sm" href={site.behance} target="_blank" rel="noopener noreferrer">
        {projects.banner.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .stack {
    /* Altura a la que se “clava” la primera card (debajo de la nav flotante) */
    --stack-top: 112px;
    /* Desfase entre cards apiladas: deja ver el borde de las anteriores */
    --stack-step: 16px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /*
    Colchón al final del stack. El sticky se recorta contra el *content box*
    del contenedor (un padding no alcanza), así que sin este espacio la última
    card nunca llega a su tope y las cuatro colapsan en la misma posición.
  */
  .stack::after {
    content: '';
    flex: 0 0 auto;
    height: calc(3 * var(--stack-step));
  }

  .pcard {
    position: sticky;
    top: calc(var(--stack-top) + var(--i) * var(--stack-step));
    /* Las de más abajo pasan por encima al superponerse */
    z-index: calc(var(--i) + 1);
  }

  .pcard__inner {
    position: relative;
    display: block;
    height: clamp(420px, 64vh, 560px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(18, 18, 24, 0.06), 0 18px 40px rgba(18, 18, 24, 0.08);
    transform-origin: 50% 0%;
    will-change: transform;
    /* --p (0→1) lo escribe el script: cuánto la cubre la card siguiente */
    transform: scale(calc(1 - 0.05 * var(--p, 0)));
    transition: box-shadow 0.3s ease;
  }

  .pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Se apaga a medida que queda tapada */
    filter: brightness(calc(1 - 0.18 * var(--p, 0))) saturate(calc(1 - 0.35 * var(--p, 0)));
  }

  .pcard__index {
    position: absolute;
    top: 24px;
    right: 28px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--ink-2);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    padding: 6px 14px;
  }

  /* Card de información superpuesta sobre la imagen */
  .pcard__info {
    position: absolute;
    left: 32px;
    bottom: 32px;
    width: min(430px, calc(100% - 64px));
    padding: 28px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 2px rgba(18, 18, 24, 0.05), 0 12px 32px rgba(18, 18, 24, 0.1);
    opacity: calc(1 - 0.65 * var(--p, 0));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pcard__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.13px;
    color: var(--muted);
  }

  .pcard__cat {
    color: var(--brand);
  }

  .pcard__dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgba(18, 18, 24, 0.28);
  }

  .pcard__title {
    margin-top: 10px;
  }

  .pcard__text {
    margin-top: 10px;
    font-size: 15px;
    line-height: 23px;
    letter-spacing: -0.15px;
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
  }

  .pcard__tags li {
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    letter-spacing: -0.12px;
    color: var(--ink-2);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 5px 12px;
  }

  .pcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.14px;
    color: var(--ink);
  }

  .pcard__arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pcard__inner:hover .pcard__arrow,
  .pcard__inner:focus-visible .pcard__arrow {
    transform: translate(2px, -2px);
  }

  .pcard__inner:hover {
    box-shadow: 0 1px 2px rgba(18, 18, 24, 0.06), 0 24px 56px rgba(18, 18, 24, 0.14);
  }

  /* Espacio final para que la última card llegue a su posición sin saltos */
  .banner {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 88px;
    padding: 28px 32px;
    background: var(--dark);
    border-radius: var(--radius);
  }

  .banner__mark {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 500;
    color: #fff;
    line-height: 1;
  }

  .banner__text {
    flex: 1;
  }

  .banner__text h4 {
    color: #fff;
  }

  .banner__text p {
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.14px;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 1024px) {
    .pcard__info {
      left: 24px;
      bottom: 24px;
      padding: 24px;
      width: min(400px, calc(100% - 48px));
    }
  }

  @media (max-width: 768px) {
    /* En mobile no hay altura suficiente para apilar: cards en columna */
    .stack {
      gap: 20px;
    }

    .stack::after {
      display: none;
    }

    .pcard {
      position: static;
    }

    .pcard__inner {
      height: auto;
      transform: none;
    }

    .pcard__img {
      position: static;
      height: 220px;
      filter: none;
    }

    .pcard__info {
      position: static;
      width: auto;
      padding: 24px 20px;
      border-radius: 0;
      background: var(--surface);
      backdrop-filter: none;
      box-shadow: none;
      opacity: 1;
    }

    .pcard__index {
      top: 16px;
      right: 16px;
    }

    .banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-top: 40px;
      padding: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__inner,
    .pcard__img,
    .pcard__info {
      transform: none;
      filter: none;
      opacity: 1;
    }
  }
</style>

<script>
  /**
   * Calcula, para cada card, cuánto la cubre la siguiente (0 → 1) y lo escribe
   * en --p. Al ser una función pura de la posición de scroll, la animación se
   * revierte sola cuando el usuario sube.
   */
  const stack = document.querySelector<HTMLElement>('[data-project-stack]');

  if (stack && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = Array.from(stack.querySelectorAll<HTMLElement>('[data-project-card]'));
    const isStacked = () => window.matchMedia('(min-width: 769px)').matches;
    let ticking = false;

    const update = () => {
      ticking = false;

      if (!isStacked()) {
        cards.forEach((card) => card.style.setProperty('--p', '0'));
        return;
      }

      const rects = cards.map((card) => card.getBoundingClientRect());

      cards.forEach((card, i) => {
        const next = rects[i + 1];
        let p = 0;

        if (next) {
          const me = rects[i];
          // Solapamiento de la card siguiente sobre esta, normalizado por su alto
          p = (me.bottom - next.top) / me.height;
          p = Math.min(1, Math.max(0, p));
        }

        card.style.setProperty('--p', p.toFixed(3));
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
