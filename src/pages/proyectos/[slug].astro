---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ExternalNote from '../../components/ExternalNote.astro';
import { projects } from '../../data/site';
import { projectDetails } from '../../data/proyectos';

export function getStaticPaths() {
  // Solo se generan los proyectos que tienen caso escrito en proyectos.ts
  return projects.items
    .filter((item) => projectDetails[item.slug])
    .map((item) => ({
      params: { slug: item.slug },
      props: { project: item, detail: projectDetails[item.slug] },
    }));
}

const { project, detail } = Astro.props;
const { hero, context, problem, research, definition, result, learnings, closing } = detail;
const gallery = result.gallery;

/**
 * Un `<a href="#">` se anuncia como enlace pero no lleva a ningún lado: con
 * `target="_blank"` además abre una pestaña en blanco. Los CTA cuyo destino
 * todavía no existe se marcan con `href: '#'` en `proyectos.ts`, así que acá
 * no se renderizan. En cuanto la URL real entre al dato, el botón vuelve solo.
 */
const heroCtas = hero.ctas.filter((cta) => cta.href !== '#');
const closingCtas = closing.ctas.filter((cta) => cta.href !== '#');
---

<Base title={detail.metaTitle} description={detail.metaDescription}>
  <Nav />

  <main id="contenido">
    <!--
      El caso es un `article`: se entiende solo, fuera del sitio.
      Cada etapa es una `section` con nombre accesible (`aria-labelledby`
      apunta al número de etapa + al titular), así el documento se puede
      recorrer por landmarks y por encabezados sin leerlo entero.
    -->
    <article class="caso" aria-labelledby="caso-titulo">
      <!-- ==================== 01 · HERO ==================== -->
      <header class="hero">
        <div class="container">
          <div class="hero__head reveal">
            <p class="hero__eyebrow">
              <span class="hero__dot" aria-hidden="true"></span>
              {hero.eyebrow}
            </p>

            <h1 class="hero__title" id="caso-titulo">
              <span class="hero__name">{hero.name}</span>
              <span class="hero__line">{hero.title.top}</span>
              <span class="ln--soft">{hero.title.em}</span>
            </h1>

            <p class="hero__text">{hero.text}</p>

            <p class="hero__ctas">
              {
                heroCtas.map((cta, i) => (
                  <a
                    class={`btn ${i === 0 ? 'btn--primary' : 'btn--ghost'}`}
                    href={cta.href}
                    target={cta.external ? '_blank' : undefined}
                    rel={cta.external ? 'noopener noreferrer' : undefined}
                  >
                    {cta.label}
                    {i === 0 && <ArrowIcon size={14} />}
                    {cta.external && <ExternalNote />}
                  </a>
                ))
              }
            </p>
          </div>

          <figure class="hero__media reveal" style={`--bg:${project.bg}`}>
            <img
              src={project.cover}
              srcset={`${project.coverSmall} 800w, ${project.cover} 1600w`}
              sizes="(max-width: 1200px) 100vw, 1152px"
              alt={`Vista general del proyecto ${project.name}`}
              width="1600"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>

          <dl class="ficha reveal" aria-label="Ficha del proyecto">
            {
              hero.meta.map((row) => (
                <div class="ficha__row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </header>

      <!-- ==================== 02 · CONTEXTO ==================== -->
      <section class="sec" id="contexto" aria-labelledby="contexto-etapa contexto-titulo">
        <div class="container">
          <div class="sec__head reveal">
            <p class="sec__label" id="contexto-etapa">{context.label}</p>
            <h2 class="sec__title" id="contexto-titulo">
              <span>{context.heading.top}</span>
              <span class="ln--soft">{context.heading.em}</span>
            </h2>
          </div>

          <div class="prosa reveal">
            {context.paragraphs.map((text) => <p>{text}</p>)}
          </div>

          <ul class="cards">
            {
              context.cards.map((card, i) => (
                <li class="card-ctx reveal" style={`--delay:${i * 80}ms`}>
                  <span class="card-ctx__icon" aria-hidden="true">
                    {card.icon}
                  </span>
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ==================== 03 · EL PROBLEMA ==================== -->
      <section class="sec sec--alt" id="problema" aria-labelledby="problema-etapa problema-titulo">
        <div class="container">
          <div class="sec__head reveal">
            <p class="sec__label" id="problema-etapa">{problem.label}</p>
            <h2 class="sec__title" id="problema-titulo">
              <span>{problem.heading.top}</span>
              <span class="ln--soft">{problem.heading.em}</span>
            </h2>
          </div>

          <div class="prosa reveal">
            {problem.paragraphs.map((text) => <p>{text}</p>)}
          </div>

          {
            problem.quotes && (
              <div class="reviews">
                {problem.quotes.map((q, i) => (
                  <blockquote class="review reveal" style={`--delay:${i * 80}ms`}>
                    <p>“{q.text}”</p>
                    <footer>
                      <cite>{q.source}</cite>
                    </footer>
                  </blockquote>
                ))}
              </div>
            )
          }

          <!-- Lista ordenada: la numeración 01, 02… la pone el `ol`, el número
               visible es decorativo y queda fuera del árbol de accesibilidad. -->
          <ol class="probs">
            {
              problem.items.map((item, i) => (
                <li class="prob reveal" style={`--delay:${i * 70}ms`}>
                  <span class="prob__n" aria-hidden="true">
                    {item.n}
                  </span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                    <p class="prob__tag">{item.tag}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <!-- Restricción o métrica de impacto: no todos los casos la traen -->
          {
            problem.highlight && (
              <aside class="highlight reveal" aria-label="Dato clave del problema">
                {problem.highlight.value && (
                  <p class="highlight__value">{problem.highlight.value}</p>
                )}
                <div class="highlight__body">
                  {problem.highlight.title && <h3>{problem.highlight.title}</h3>}
                  <p>{problem.highlight.text}</p>
                </div>
              </aside>
            )
          }
        </div>
      </section>

      <!-- ==================== 04 · RESEARCH ==================== -->
      <section class="sec" id="research" aria-labelledby="research-etapa research-titulo">
        <div class="container">
          <div class="sec__head reveal">
            <p class="sec__label" id="research-etapa">{research.label}</p>
            <h2 class="sec__title" id="research-titulo">
              <span>{research.heading.top}</span>
              <span class="ln--soft">{research.heading.em}</span>
            </h2>
          </div>

          <div class="prosa reveal">
            {research.intro.map((text) => <p>{text}</p>)}
          </div>

          <ul class="metodos">
            {
              research.methods.map((m, i) => (
                <li class="metodo reveal" style={`--delay:${i * 70}ms`}>
                  <p class="metodo__label">{m.label}</p>
                  <h3>{m.title}</h3>
                  {m.paragraphs.map((text) => (
                    <p>{text}</p>
                  ))}
                  <ul class="chips" aria-label={`Métodos y herramientas de ${m.title}`}>
                    {m.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>

          <!-- La cita del hallazgo principal existe solo en algunos casos -->
          {
            research.insight && (
              <figure class="insight reveal">
                <blockquote>
                  <p>“{research.insight.text}”</p>
                </blockquote>
                <figcaption>
                  <cite>{research.insight.source}</cite>
                </figcaption>
              </figure>
            )
          }

          <h3 class="sub reveal" id="research-hallazgos">{research.findingsTitle}</h3>
          <ul class="hallazgos" aria-labelledby="research-hallazgos">
            {
              research.findings.map((f, i) => (
                <li class="hallazgo reveal" style={`--delay:${i * 70}ms`}>
                  <p class="hallazgo__n">{f.n}</p>
                  <p>{f.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ==================== 05 · DEFINICIÓN ==================== -->
      <section
        class="sec sec--alt"
        id="definicion"
        aria-labelledby="definicion-etapa definicion-titulo"
      >
        <div class="container">
          <div class="sec__head reveal">
            <p class="sec__label" id="definicion-etapa">{definition.label}</p>
            <h2 class="sec__title" id="definicion-titulo">
              <span>{definition.heading.top}</span>
              <span class="ln--soft">{definition.heading.em}</span>
            </h2>
          </div>

          {
            definition.paragraphs.length > 0 && (
              <div class="prosa reveal">
                {definition.paragraphs.map((text) => (
                  <p>{text}</p>
                ))}
              </div>
            )
          }

          {
            definition.blocks.map((block, b) => (
              <div class="bloque">
                <h3 class="sub reveal" id={`definicion-b${b}`}>
                  {block.title}
                </h3>

                {block.kind === 'steps' && (
                  <ol class="pasos" aria-labelledby={`definicion-b${b}`}>
                    {block.items.map((item, i) => (
                      <li class="paso reveal" style={`--delay:${i * 60}ms`}>
                        {item.label && <p class="paso__label">{item.label}</p>}
                        <h4>{item.title}</h4>
                        {item.lines.map((line) => (
                          <p>{line}</p>
                        ))}
                      </li>
                    ))}
                  </ol>
                )}

                {block.kind === 'decisions' && (
                  <>
                  <ul class="decisiones" aria-labelledby={`definicion-b${b}`}>
                    {block.items.map((item, i) => (
                      <li class="decision reveal" style={`--delay:${i * 60}ms`}>
                        <h4>{item.title}</h4>
                        {/* Antes / Después / Por qué son pares dato-valor */}
                        <dl class="decision__ba">
                          <div class="decision__antes">
                            <dt>Antes</dt>
                            <dd>{item.before}</dd>
                          </div>
                          <div class="decision__despues">
                            <dt>Después</dt>
                            <dd>{item.after}</dd>
                          </div>
                          <div class="decision__why">
                            <dt>Por qué</dt>
                            <dd>{item.why}</dd>
                          </div>
                        </dl>
                      </li>
                    ))}
                  </ul>
                  {block.result && <p class="resultado-bloque reveal">{block.result}</p>}
                  </>
                )}

                {block.kind === 'sitemap' && (
                  <div class="mapa">
                    {block.groups.map((g, i) => (
                      <section class="mapa__grupo reveal" style={`--delay:${i * 60}ms`}>
                        <h4 id={`mapa-${b}-${i}`}>{g.title}</h4>
                        <ul aria-labelledby={`mapa-${b}-${i}`}>
                          {g.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </section>
                    ))}
                    {block.total && <p class="mapa__total reveal">{block.total}</p>}
                  </div>
                )}

                {block.kind === 'compare' && (
                  <div class="compara reveal">
                    <section class="compara__col" aria-labelledby={`comp-${b}-antes`}>
                      <h4 class="compara__label" id={`comp-${b}-antes`}>
                        {block.before.label}
                      </h4>
                      <p>{block.before.text}</p>
                    </section>
                    <section
                      class="compara__col compara__col--after"
                      aria-labelledby={`comp-${b}-despues`}
                    >
                      <h4 class="compara__label" id={`comp-${b}-despues`}>
                        {block.after.label}
                      </h4>
                      <p>{block.after.text}</p>
                    </section>
                    <p class="compara__result">{block.result}</p>
                  </div>
                )}

                {block.kind === 'note' && (
                  <div class="nota reveal">
                    {block.paragraphs.map((text) => (
                      <p>{text}</p>
                    ))}
                    {block.subs && (
                      <div class="nota__subs">
                        {block.subs.map((sub) => (
                          <section class="nota__sub">
                            <h4>{sub.title}</h4>
                            {sub.paragraphs.map((text) => (
                              <p>{text}</p>
                            ))}
                          </section>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))
          }

          <!-- Mockup de cierre: lo definido, ya construido -->
          {
            definition.image && (
              <figure class="mockup reveal">
                <img
                  src={definition.image.src}
                  alt={definition.image.alt}
                  width="1163"
                  height="554"
                  loading="lazy"
                  decoding="async"
                />
                {definition.image.caption && (
                  <figcaption>{definition.image.caption}</figcaption>
                )}
              </figure>
            )
          }
        </div>
      </section>

      <!-- ==================== 06 · RESULTADO ==================== -->
      <section
        class="sec"
        id="resultado"
        aria-labelledby="resultado-etapa resultado-titulo"
      >
        <div class="container">
          <div class="sec__head reveal">
            <p class="sec__label" id="resultado-etapa">{result.label}</p>
            <h2 class="sec__title" id="resultado-titulo">
              <span>{result.heading.top}</span>
              <span class="ln--soft">{result.heading.em}</span>
            </h2>
          </div>

          {
            result.intro && (
              <div class="prosa reveal">
                {result.intro.map((text) => (
                  <p>{text}</p>
                ))}
              </div>
            )
          }

          <!-- Cada métrica es un par valor→qué mide: `dl` lo dice sin depender
               del orden visual. -->
          <dl class="metricas" aria-label="Métricas del resultado">
            {
              result.metrics.map((m, i) => (
                <div class="metrica reveal" style={`--delay:${i * 70}ms`}>
                  <dt class="metrica__value">{m.value}</dt>
                  <dd>
                    <span class="metrica__label">{m.label}</span>
                    {m.text && <span class="metrica__text">{m.text}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            result.qualitative && result.qualitative.length > 0 && (
              <>
                <h3 class="sub reveal" id="resultado-cualitativo">
                  {result.qualitativeTitle}
                </h3>
                <ul class="cualitativos" aria-labelledby="resultado-cualitativo">
                  {result.qualitative.map((q, i) => (
                    <li class="cualitativo reveal" style={`--delay:${i * 60}ms`}>
                      <h4>{q.title}</h4>
                      <p>{q.text}</p>
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            result.feedback && (
              <aside class="nota nota--brand reveal" aria-labelledby="resultado-feedback">
                <h3 id="resultado-feedback">{result.feedback.title}</h3>
                <p>{result.feedback.text}</p>
              </aside>
            )
          }

          <!--
            Galería. Sin imágenes cargadas se listan las capturas que faltan:
            son notas de trabajo, no imágenes, por eso van como texto y no
            como `img` sin archivo.
          -->
          <h3 class="sub reveal" id="resultado-galeria">{gallery.title}</h3>
          {
            gallery.images.length > 0 ? (
              <div class="galeria" aria-labelledby="resultado-galeria">
                {gallery.images.map((img) => (
                  <figure class="mockup reveal">
                    <img
                      src={img.src}
                      alt={img.alt}
                      width="1163"
                      height="554"
                      loading="lazy"
                      decoding="async"
                    />
                    {img.caption && <figcaption>{img.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            ) : (
              <ul class="galeria-ph reveal" aria-labelledby="resultado-galeria">
                {(gallery.shots ?? []).map((shot, n) => (
                  <li class="galeria__ph" style={`--bg:${project.bg}; --n:${n}`}>
                    <span class="galeria__phLabel">{shot}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>

      <!-- ==================== 07 · APRENDIZAJES ====================
           Roe & Eu cierra con CTA en lugar de aprendizajes: la etapa
           aparece solo cuando el caso la tiene escrita. -->
      {
        learnings && (
          <section
            class="sec sec--alt"
            id="aprendizajes"
            aria-labelledby="aprendizajes-etapa aprendizajes-titulo"
          >
            <div class="container">
              <div class="sec__head reveal">
                <p class="sec__label" id="aprendizajes-etapa">{learnings.label}</p>
                <h2 class="sec__title" id="aprendizajes-titulo">
                  <span>{learnings.heading.top}</span>
                  <span class="ln--soft">{learnings.heading.em}</span>
                </h2>
              </div>

              <ol class="aprendizajes">
                {learnings.items.map((l, i) => (
                  <li class="aprendizaje reveal" style={`--delay:${i * 60}ms`}>
                    <span class="aprendizaje__n" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <div>
                      {l.label && <p class="aprendizaje__label">{l.label}</p>}
                      <h3>{l.title}</h3>
                      {l.paragraphs.map((text) => (
                        <p>{text}</p>
                      ))}
                    </div>
                  </li>
                ))}
              </ol>

              {learnings.different && (
                <aside class="nota nota--brand reveal" aria-labelledby="aprendizajes-diferente">
                  <h3 id="aprendizajes-diferente">{learnings.different.title}</h3>
                  <p>{learnings.different.text}</p>
                </aside>
              )}
            </div>
          </section>
        )
      }

      <!-- ==================== 08 · CIERRE ==================== -->
      <footer class="cierre">
        <div class="container">
          <section class="cta reveal" aria-labelledby="cierre-titulo">
            <h2 id="cierre-titulo">
              <span>{closing.heading.top}</span>
              <span class="ln--soft">{closing.heading.em}</span>
            </h2>
            <p>{closing.text}</p>
            <p class="cta__botones">
              {
                closingCtas.map((cta, i) => (
                  <a
                    class={`btn ${i === 0 ? 'btn--primary' : 'btn--light'}`}
                    href={cta.href}
                    target={cta.external ? '_blank' : undefined}
                    rel={cta.external ? 'noopener noreferrer' : undefined}
                  >
                    {cta.label}
                    {i === 0 && <ArrowIcon size={14} />}
                    {cta.external && <ExternalNote />}
                  </a>
                ))
              }
            </p>
          </section>

          <nav class="cierre__nav" aria-label="Navegación entre casos">
            <a class="next reveal" href={closing.next.href}>
              <span class="next__label">{closing.next.label}</span>
              <span class="next__title">
                {closing.next.title}
                <span class="next__arrow" aria-hidden="true">
                  <ArrowIcon size={16} />
                </span>
              </span>
              <span class="next__text">{closing.next.text}</span>
            </a>

            <p class="volver">
              <a href="/proyectos"><span aria-hidden="true">←</span> Todos los proyectos</a>
            </p>
          </nav>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Base>

<style>
  /* =========================================================
     Base del caso
     ========================================================= */
  .caso {
    padding-bottom: 0;
  }

  .sec {
    padding-block: 88px;
    border-top: 1px solid var(--line);
  }

  .sec--alt {
    background: var(--surface-2);
  }

  .sec__head {
    max-width: 760px;
    margin-bottom: 32px;
  }

  .sec__label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 16px;
  }

  .sec__title {
    font-size: 40px;
    line-height: 46px;
    letter-spacing: -0.9px;
  }

  /*
    Las dos líneas del titular son `span` de bloque, no `<br>` ni `<em>`:
    el salto es una decisión de diseño, no un énfasis del texto.
  */
  .sec__title span,
  .cta h2 span,
  .hero__title span {
    display: block;
  }

  .ln--soft {
    color: var(--muted);
  }

  .prosa {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .prosa p {
    font-size: 17px;
    line-height: 28px;
    letter-spacing: -0.34px;
  }

  .sub {
    margin-top: 56px;
    margin-bottom: 20px;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.4px;
    font-weight: 500;
  }

  /* =========================================================
     01 · Hero
     ========================================================= */
  .hero {
    padding-top: 152px;
    padding-bottom: 24px;
  }

  .hero__head {
    max-width: 860px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--brand);
  }

  .hero__title {
    margin-top: 20px;
    font-size: 60px;
    line-height: 66px;
    letter-spacing: -1.4px;
  }

  /* El nombre del proyecto vive dentro del h1: es parte del título del caso */
  .hero__name {
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 8px;
  }

  .hero__text {
    max-width: 640px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 30px;
    letter-spacing: -0.36px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__media {
    margin: 56px 0 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg, var(--surface-2));
    box-shadow: var(--shadow-card);
  }

  .hero__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Ficha de datos del proyecto */
  .ficha {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 40px 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .ficha__row {
    padding: 18px 20px;
    background: var(--surface);
  }

  .ficha__row dt {
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ficha__row dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 23px;
    letter-spacing: -0.15px;
    font-weight: 500;
    color: var(--ink);
  }

  /* =========================================================
     02 · Cards de contexto
     ========================================================= */
  .cards {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 48px 0 0;
  }

  .card-ctx {
    padding: 26px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line);
  }

  .card-ctx__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--surface-2);
    font-size: 20px;
    margin-bottom: 18px;
  }

  .card-ctx h3 {
    font-size: 18px;
    line-height: 26px;
    letter-spacing: -0.36px;
    margin-bottom: 10px;
  }

  .card-ctx p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  /* =========================================================
     03 · Problema
     ========================================================= */
  .reviews {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .review {
    margin: 0;
    padding: 24px 26px;
    background: var(--surface);
    border-radius: var(--radius);
    border-left: 3px solid var(--brand);
  }

  .review p {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 27px;
    letter-spacing: -0.34px;
    color: var(--ink);
  }

  .review footer {
    margin-top: 12px;
    font-size: 13px;
    letter-spacing: -0.13px;
    color: var(--muted);
  }

  .review cite,
  .insight cite {
    font-style: normal;
  }

  .probs {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .prob {
    display: flex;
    gap: 18px;
    padding: 26px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .prob__n {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.15px;
    color: var(--brand);
  }

  .prob h3 {
    font-size: 18px;
    line-height: 26px;
    letter-spacing: -0.36px;
    margin-bottom: 10px;
  }

  .prob p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  .prob__tag {
    display: inline-block;
    margin-top: 14px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.12px;
    color: var(--muted);
  }

  .highlight {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 40px;
    padding: 36px 40px;
    border-radius: var(--radius-lg);
    background: var(--dark);
  }

  .highlight__value {
    font-family: var(--font-display);
    font-size: 72px;
    line-height: 1;
    letter-spacing: -2.5px;
    font-weight: 600;
    color: #fff;
    flex: 0 0 auto;
  }

  .highlight__body h3 {
    color: #fff;
    font-size: 22px;
    line-height: 30px;
    letter-spacing: -0.44px;
    margin-bottom: 10px;
  }

  .highlight__body p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    line-height: 26px;
    letter-spacing: -0.32px;
    max-width: 680px;
  }

  /* =========================================================
     04 · Research
     ========================================================= */
  .metodos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin: 48px 0 0;
  }

  .metodo {
    padding: 28px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line);
  }

  .metodo__label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 12px;
  }

  .metodo h3 {
    font-size: 19px;
    line-height: 27px;
    letter-spacing: -0.38px;
    margin-bottom: 12px;
  }

  .metodo p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  .metodo p + p {
    margin-top: 12px;
  }

  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .chips li {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }

  .insight {
    margin: 56px 0 0;
    padding: 44px 48px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    border-left: 4px solid var(--brand);
  }

  .insight blockquote {
    margin: 0;
  }

  .insight blockquote p {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 38px;
    letter-spacing: -0.6px;
    font-weight: 500;
    color: var(--ink);
  }

  .insight figcaption {
    margin-top: 18px;
    font-size: 13px;
    letter-spacing: -0.13px;
    color: var(--muted);
  }

  .hallazgos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  /* Con uno o dos hallazgos la fila se completa en vez de dejar huecos */
  .hallazgos:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hallazgos:has(> :only-child) {
    grid-template-columns: minmax(0, 1fr);
  }

  .hallazgo {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .hallazgo__n {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 12px;
  }

  .hallazgo p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  /* =========================================================
     05 · Definición
     ========================================================= */
  .bloque + .bloque {
    margin-top: 16px;
  }

  .pasos,
  .decisiones {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .paso,
  .decision {
    padding: 24px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .paso__label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 10px;
  }

  .paso h4,
  .decision h4 {
    font-size: 17px;
    line-height: 25px;
    letter-spacing: -0.34px;
    margin-bottom: 10px;
    word-break: break-word;
  }

  .paso p,
  .decision dd {
    font-size: 15px;
    line-height: 24px;
    letter-spacing: -0.3px;
    color: var(--muted);
  }

  .paso p + p {
    margin-top: 8px;
  }

  .decision__ba {
    margin: 0;
  }

  .decision__antes,
  .decision__despues {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    margin-bottom: 10px;
  }

  .decision__despues {
    background: rgba(28, 87, 235, 0.07);
  }

  .decision__ba dt {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .decision__ba dd {
    margin: 0;
  }

  .decision__why {
    margin-top: 12px;
  }

  .mapa {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .mapa__grupo {
    padding: 24px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mapa__grupo h4 {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.32px;
    margin-bottom: 12px;
  }

  .mapa__grupo ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mapa__grupo li {
    font-size: 14px;
    line-height: 22px;
    letter-spacing: -0.28px;
    color: var(--muted);
  }

  .mapa__total {
    grid-column: 1 / -1;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }

  .compara {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .compara__col {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .compara__col--after {
    background: var(--dark);
  }

  .compara__col--after .compara__label {
    color: rgba(255, 255, 255, 0.6);
  }

  .compara__col--after p {
    color: #fff;
  }

  /* Es un h4: hay que anular la escala global del encabezado */
  .compara__label {
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .compara__col p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  /* Cierre de un bloque de decisiones: el resultado al que llevaron */
  .resultado-bloque {
    margin-top: 16px;
  }

  .compara__result,
  .resultado-bloque {
    grid-column: 1 / -1;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    background: rgba(28, 87, 235, 0.08);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.32px;
    color: var(--brand);
  }

  .nota {
    padding: 32px 36px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .nota--brand {
    margin-top: 48px;
    border-left: 4px solid var(--brand);
  }

  .nota h3 {
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.4px;
    margin-bottom: 14px;
  }

  .nota p {
    font-size: 16px;
    line-height: 26px;
    letter-spacing: -0.32px;
  }

  .nota p + p {
    margin-top: 12px;
  }

  .nota__lista {
    margin: 14px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nota__lista li {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
    color: var(--muted);
  }

  .nota__subs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .nota__sub {
    padding: 20px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .nota__sub h4 {
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.32px;
    margin-bottom: 8px;
  }

  .nota__sub p {
    font-size: 15px;
    line-height: 24px;
  }

  /* =========================================================
     Galería de pantallas (cierra la etapa de Resultado)
     ========================================================= */
  /*
    Mockup ancho (1163×554). Los render vienen sobre blanco, así que la card
    es blanca: los bordes de la imagen se funden con la tarjeta en lugar de
    recortarse contra el color del proyecto.
  */
  .mockup {
    margin: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line);
    overflow: hidden;
  }

  .mockup img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1163 / 554;
    object-fit: cover;
  }

  .mockup figcaption {
    padding: 16px 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 22px;
    letter-spacing: -0.28px;
    color: var(--muted);
  }

  /* En la etapa de Definición el mockup cierra la sección */
  #definicion .mockup {
    margin-top: 40px;
  }

  /* Va después del `h3.sub`, que ya aporta el aire de arriba */
  .galeria {
    display: grid;
    gap: 20px;
  }

  .galeria-ph {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
  }

  /*
    Placeholder: usa el color del proyecto y nombra la captura que falta,
    para que se lea como pendiente y no como un error de carga.
  */
  .galeria__ph {
    display: grid;
    place-items: center;
    padding: 20px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    border: 1px dashed rgba(18, 18, 24, 0.18);
    background: linear-gradient(
      calc(120deg + var(--n) * 45deg),
      color-mix(in srgb, var(--bg, var(--surface-2)) 92%, #000) 0%,
      color-mix(in srgb, var(--bg, var(--surface-2)) 55%, #fff) 55%,
      color-mix(in srgb, var(--bg, var(--surface-2)) 80%, #000) 100%
    );
  }

  .galeria__phLabel {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    line-height: 18px;
    letter-spacing: 0.2px;
    text-align: center;
    color: rgba(18, 18, 24, 0.55);
    background: rgba(255, 255, 255, 0.78);
    border-radius: 999px;
    padding: 7px 14px;
  }

  /* =========================================================
     06 · Resultado
     ========================================================= */
  .metricas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 48px 0 0;
  }

  /* Con tres métricas la fila se reparte en tres, sin columna vacía */
  .metricas:has(> :nth-child(3):last-child) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .metrica {
    padding: 26px 24px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line);
  }

  .metrica__value {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1.05;
    letter-spacing: -1.4px;
    font-weight: 600;
    color: var(--brand);
  }

  .metrica dd {
    margin: 0;
  }

  .metrica__label {
    display: block;
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 23px;
    letter-spacing: -0.3px;
    font-weight: 500;
    color: var(--ink);
  }

  .metrica__text {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    line-height: 22px;
    letter-spacing: -0.28px;
    color: var(--muted);
  }

  .cualitativos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 0;
  }

  .cualitativo {
    padding: 24px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .cualitativo h4 {
    font-size: 17px;
    line-height: 25px;
    letter-spacing: -0.34px;
    margin-bottom: 10px;
  }

  .cualitativo p {
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
  }

  /* =========================================================
     07 · Aprendizajes
     ========================================================= */
  .aprendizajes {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .aprendizaje {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 24px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }

  .aprendizaje:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .aprendizaje__n {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
    letter-spacing: -1px;
    font-weight: 600;
    color: rgba(18, 18, 24, 0.18);
  }

  .aprendizaje__label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 8px;
  }

  .aprendizaje h3 {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.48px;
    margin-bottom: 14px;
    max-width: 760px;
  }

  .aprendizaje p {
    max-width: 760px;
    font-size: 16px;
    line-height: 27px;
    letter-spacing: -0.32px;
  }

  .aprendizaje p + p {
    margin-top: 12px;
  }

  /* =========================================================
     08 · Cierre
     ========================================================= */
  .cierre {
    padding-block: 88px;
    border-top: 1px solid var(--line);
  }

  .cta {
    padding: 64px 56px;
    border-radius: var(--radius-lg);
    background: var(--dark);
    text-align: center;
  }

  .cta h2 {
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.9px;
    color: #fff;
  }

  .cta h2 .ln--soft {
    color: rgba(255, 255, 255, 0.55);
  }

  .cta p {
    max-width: 640px;
    margin: 20px auto 0;
    font-size: 17px;
    line-height: 28px;
    letter-spacing: -0.34px;
    color: rgba(255, 255, 255, 0.7);
  }

  .cta__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .btn--light {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .btn--light:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .next {
    display: block;
    margin-top: 24px;
    padding: 32px 36px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .next:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-nav), inset 0 0 0 1px var(--line);
  }

  .next__label {
    display: block;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--brand);
  }

  .next__title {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 36px;
    letter-spacing: -0.56px;
    font-weight: 500;
    color: var(--ink);
  }

  .next__arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .next:hover .next__arrow {
    transform: translate(2px, -2px);
  }

  .next__text {
    display: block;
    max-width: 620px;
    margin-top: 10px;
    font-size: 15px;
    line-height: 25px;
    letter-spacing: -0.3px;
    color: var(--muted);
  }

  .volver {
    margin-top: 32px;
  }

  .volver a {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.14px;
    color: var(--muted);
  }

  .volver a:hover {
    color: var(--ink);
  }

  /* =========================================================
     Responsive
     ========================================================= */
  @media (max-width: 1024px) {
    .hero {
      padding-top: 132px;
    }

    .hero__title {
      font-size: 46px;
      line-height: 54px;
      letter-spacing: -1px;
    }

    .sec__title,
    .cta h2 {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -0.7px;
    }

    .ficha {
      grid-template-columns: repeat(2, 1fr);
    }

    .cards,
